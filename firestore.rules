rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authPhone() {
      return request.auth.token.email.split('@')[0];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == '0553731265@accounts.nursing-club.app';
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(authPhone())).data.role;
    }

    function isStaff() {
      return isAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(authPhone())) &&
        userRole() in [
          'System Admin',
          'General Supervisor',
          'رئيس النادي',
          'نائبة الرئيس'
        ]
      );
    }

    function isCommitteeLeader() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(authPhone()))
        && userRole().matches('.*(قائد|قائدة|رئيس لجنة|رئيسة لجنة|مشرف|جودة).*');
    }

    function isClubOperator() {
      return isStaff() || isCommitteeLeader();
    }

    function writesPassword() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['password']);
    }

    match /users/{phone} {
      allow get: if signedIn()
        || resource == null
        || !resource.data.keys().hasAny(['password']);
      allow list: if isClubOperator();
      allow create: if signedIn()
        && (authPhone() == phone || isClubOperator())
        && !request.resource.data.keys().hasAny(['password']);
      allow delete: if isAdmin();
      allow update: if (isAdmin()
          || isStaff()
          || isCommitteeLeader()
          || (signedIn() && authPhone() == phone
              && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'assignedCommittee']))
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['latestNotification', 'lastActive', 'warningHidden', 'hasSeenCongrats', 'pendingCongratulation'])))
        && (!request.resource.data.keys().hasAny(['password']) || !writesPassword());
    }

    match /applications/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /suggestions/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /case_study_competition_votes/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /case_study_trial_votes/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /case_study_submissions/{id} {
      allow read: if true;
      // معرف ثابت: جوال_اليوم — يمنع تسليمين لنفس الحساب في نفس اليوم
      allow create: if request.resource.data.phone is string
        && request.resource.data.day is string
        && request.resource.data.attemptId is string
        && id == request.resource.data.attemptId
        && id == request.resource.data.phone + '_' + request.resource.data.day
        && exists(/databases/$(database)/documents/case_study_attempts/$(id))
        && get(/databases/$(database)/documents/case_study_attempts/$(id)).data.phone == request.resource.data.phone
        && get(/databases/$(database)/documents/case_study_attempts/$(id)).data.day == request.resource.data.day
        && !(get(/databases/$(database)/documents/case_study_attempts/$(id)).data.submittedAt is number);
      allow update, delete: if isStaff();
    }

    // بداية وقت الحل لليوم — تُنشأ مرة، ويُسمح بختم التسليم مرة واحدة فقط
    match /case_study_attempts/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if resource.data.keys().hasAll(['phone', 'day', 'startedAt'])
        && !(resource.data.submittedAt is number)
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.day == resource.data.day
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.submittedAt is number;
      allow delete: if isStaff();
    }

    match /site_settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_newsletters/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_events/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_banners/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_partners/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_passion_slides/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_discover_events/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_scientific_texts/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /scientific_committee_texts/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /design_committee_works/{id} {
      allow read, write: if signedIn();
    }

    match /public_partners_relations/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /committees/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /committee_honor_board/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /student_achievements/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /certificates/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /site_certificates/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /hr_certificate_batches/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /event_excuses/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isClubOperator();
    }

    match /event_excuse_notices/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isClubOperator();
    }

    match /inactive_member_reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isClubOperator();
    }

    match /member_warnings/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isClubOperator();
    }

    match /admin_documents/{id} {
      allow read, write: if isClubOperator();
    }

    match /pr_documents/{id} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
